{
  "manifest_version": 3,
  "name": "B站视频下载器",
  "version": "0.1.0",
  "description": "在 B 站视频页一键下载公开视频，支持多 P、清晰度选择与音视频自动合并为 MP4。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "*://*.bilivideo.com/*",
    "*://*.bilivideo.cn/*",
    "*://*.mcdn.bilivideo.cn/*",
    "*://*.mountaintoys.cn/*",
    "*://*.hdslb.com/*",
    "*://*.akamaized.net/*",
    "*://*.szbdyd.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "media-referer",
        "enabled": true,
        "path": "rules/media-referer.json"
      }
    ]
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.bilibili.com/video/*"
      ],
      "js": [
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "B站视频下载器",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"
  }
}
